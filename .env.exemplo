# Exemplo de configuração do Expotec 2026
# Copie para .env e preencha os valores adequados ao ambiente.

# Desenvolvimento: True | Produção: False
DEBUG=True

# Gere uma chave exclusiva e forte para produção.
SECRET_KEY=SUBSTITUIR_POR_CHAVE_SEGURA

# Endereço base da aplicação
BASE_URL=http://127.0.0.1:8000

# Hosts permitidos, separados por espaço
ALLOWED_HOSTS="127.0.0.1 localhost"

# Origens confiáveis para CSRF (necessário conforme o acesso)
# Exemplo: CSRF_TRUSTED_ORIGINS=https://expotec.exemplo.br

# E-mail
EMAIL_HOST=
EMAIL_PORT=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# SUAP OAuth
SUAP_CLIENT_ID=
SUAP_CLIENT_SECRET=

# MySQL: necessário em produção
DB_NAME=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=

# Arquivos em produção: preencher quando o servidor estiver definido
# STATIC_ROOT=/caminho/absoluto/staticfiles
# MEDIA_ROOT=/caminho/absoluto/media
